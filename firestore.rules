rules_version = '2';

// Hasthakala Firestore security rules - v1.4
// NFR3: access is enforced here, not only by hiding buttons in the app.
// Field names follow docs/FIREBASE_SCHEMA.md (locked).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Fields in this update that differ from the stored document.
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- I01 Entry/Auth: account documents (FINAL) ----------
    // A user can only see/edit their own account. There is no role field to
    // escalate: contexts come from artisanProfiles and supportGrants.
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.primaryPurpose in ['shop', 'sell'];
      allow update: if isSelf(uid)
        && !('uid' in changed()) && !('email' in changed());
      allow delete: if false;

      // I06 cart - only the owner.
      match /cart/{productId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- Admins: created ONLY from the Firebase console ----------
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ---------- I05 Artisan profile (FINAL) ----------
    // Any signed-in user can view (public profile). Only the artisan edits it,
    // and never the 'verified' badge (FR4). Only an admin can set 'verified'.
    match /artisanProfiles/{artisanUid} {
      allow read: if signedIn();
      allow create: if isSelf(artisanUid)
        && request.resource.data.artisanUid == artisanUid
        && request.resource.data.verified == false;
      allow update: if (isSelf(artisanUid)
                        && !('verified' in changed())
                        && !('artisanUid' in changed()))
                    || (isAdmin() && changed().hasOnly(['verified', 'updatedAt']));
      allow delete: if false;
    }

    // ---------- TEMPORARY development rules - signed-in users only ----------
    // MUST be replaced with owner/role/support-grant rules (v2) before
    // functional testing. Tracked in docs/DECISIONS.md.
    match /products/{doc=**}      { allow read, write: if signedIn(); }
    match /orders/{doc=**}        { allow read, write: if signedIn(); }
    match /conversations/{doc=**} { allow read, write: if signedIn(); }
    match /reviews/{doc=**}       { allow read, write: if signedIn(); }

    // ---------- I13 Family Assistance (FINAL) ----------
    // Authentication = who you are (always yourself).
    // Authorisation  = what you may do for an artisan: ONLY an active grant
    // whose scopes are true. Supporters can never manage support users.
    function hasArtisanProfile(uid) {
      return exists(/databases/$(database)/documents/artisanProfiles/$(uid));
    }
    function validScopes(s) {
      return s.keys().hasOnly(['products', 'orders', 'communication'])
        && s.products is bool && s.orders is bool && s.communication is bool;
    }
    function myPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone;
    }
    // Accepting an invite: the new grant must copy the pending, unexpired
    // invite exactly, for the signed-in supporter, whose phone must match.
    function isValidAcceptance(grantId) {
      let d = request.resource.data;
      let inv = get(/databases/$(database)/documents/supportInvites/$(d.inviteCode)).data;
      return d.supporterId == request.auth.uid
        && grantId == d.artisanId + '_' + request.auth.uid
        && d.artisanId != request.auth.uid
        && d.status == 'active'
        && inv.status == 'pending'
        && inv.expiresAt > request.time
        && inv.artisanId == d.artisanId
        && inv.artisanName == d.artisanName
        && inv.relationship == d.relationship
        && inv.phone == d.phone
        && inv.phone == myPhone()
        && inv.scopes == d.scopes;
    }
    // Used by rules v2 (products / orders / conversations).
    function hasScope(artisanId, scope) {
      let grantPath = /databases/$(database)/documents/supportGrants/$(artisanId + '_' + request.auth.uid);
      return signedIn() && exists(grantPath)
        && get(grantPath).data.status == 'active'
        && get(grantPath).data.scopes[scope] == true;
    }

    match /supportInvites/{code} {
      allow create: if signedIn()
        && hasArtisanProfile(request.auth.uid)
        && code.matches('^[0-9]{6}$')
        && request.resource.data.code == code
        && request.resource.data.artisanId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.phone.matches('^0[0-9]{9}$')
        && request.resource.data.expiresAt > request.time
        && validScopes(request.resource.data.scopes);
      // Owner reads own invites; an invitee reads one only with the matching phone.
      allow get: if signedIn()
        && (resource.data.artisanId == request.auth.uid
            || (resource.data.status == 'pending' && resource.data.phone == myPhone()));
      allow list: if signedIn() && resource.data.artisanId == request.auth.uid;
      allow update: if signedIn() && (
        // owner revokes an invite
        (resource.data.artisanId == request.auth.uid
          && changed().hasOnly(['status'])
          && request.resource.data.status == 'revoked')
        // owner renamed their artisan profile
        || (resource.data.artisanId == request.auth.uid
          && changed().hasOnly(['artisanName']))
        // invitee marks it accepted, in the same write that creates the grant
        || (resource.data.status == 'pending'
          && changed().hasOnly(['status', 'acceptedBy'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedBy == request.auth.uid
          && existsAfter(/databases/$(database)/documents/supportGrants/$(resource.data.artisanId + '_' + request.auth.uid))));
      // owner cancels an invite that was not accepted
      allow delete: if signedIn()
        && resource.data.artisanId == request.auth.uid
        && resource.data.status == 'pending';
    }

    match /supportGrants/{grantId} {
      allow read: if signedIn()
        && (resource.data.supporterId == request.auth.uid
            || resource.data.artisanId == request.auth.uid);
      allow create: if signedIn() && isValidAcceptance(grantId);
      allow update: if signedIn() && (
        // owner edits permissions or revokes
        (resource.data.artisanId == request.auth.uid
          && changed().hasOnly(['scopes', 'status', 'updatedAt', 'artisanName'])
          && validScopes(request.resource.data.scopes)
          && request.resource.data.status in ['active', 'revoked'])
        // supporter re-accepts a NEW invite (e.g. after a revoke)
        || (resource.data.supporterId == request.auth.uid && isValidAcceptance(grantId)));
      allow delete: if false;
    }
    // Everything not listed above is denied by default.
  }
}
